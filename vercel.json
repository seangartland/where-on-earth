{
  "rewrites": [
    {
      "source": "/lib/:ver/:path*",
      "destination": "/vendor/:path*"
    }
  ],
  "headers": [
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Clear-Site-Data",
          "value": "\"cache\""
        }
      ],
      "source": "/"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Clear-Site-Data",
          "value": "\"cache\""
        }
      ],
      "source": "/(.*).html"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ],
      "source": "/src/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/src/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ]
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ],
      "source": "/vendor/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/lib/:ver/:path*"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ],
      "source": "/assets/(.*)"
    },
    {
      "source": "/assets/(.*)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  }
}