async function sendChallenge(copyOnly = false) {
  if (!sheetShare) return;
  const name = rememberName();
  syncSheetSignature();
  const url = challengeUrl(sheetShare.item, sheetShare.km, name);
  const text = challengeMessage(sheetShare).share;
  if (!copyOnly && canShare()) {
    try {
      await navigator.share({ title: 'Where on Earth?', text, url });
      chsEls.status.textContent = 'Challenge sent ✓';
      setTimeout(closeChallengeSheet, 700);
      return;
    } catch (err) {
      if (err && err.name === 'AbortError') return; // closed the share sheet: stay here
    }
  }
  try {
    await navigator.clipboard.writeText(`${text}\n${url}`);
    chsEls.status.textContent = 'Link copied. Paste it into any chat.';
    const button = copyOnly ? chsEls.copy : chsEls.send;
    const label = button.textContent;
    button.textContent = '✓ Copied';
    clearTimeout(sheetCopiedTimer);
    sheetCopiedTimer = setTimeout(() => { button.textContent = label; }, 1800);
  } catch {
    // No clipboard (insecure context, denied): hand them the link to copy by hand.
    chsEls.status.textContent = 'Couldn’t copy. Long-press the link to copy it.';
    chsEls.link.value = url;
    chsEls.link.hidden = false;
    chsEls.link.focus();
    chsEls.link.select();
  }
}

