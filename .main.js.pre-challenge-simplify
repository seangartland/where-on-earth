function cleanName(text) {
  return String(text || '').replace(/[\u0000-\u001f\u007f]/g, '').replace(/\s+/g, ' ').trim().slice(0, 20);
}

function savedName() {
  try { return cleanName(localStorage.getItem(NAME_KEY)); } catch { return ''; }
}

function placeName(item) {
  if (!item.short) return item.clue || '';
  const flag = (item.clue || '').match(FLAG_RE);
  return `${item.short}${flag ? ` ${flag[0]}` : ''}`;
}

const kmLabel = (km) => `${km.toLocaleString()} km`;

// "got within 42 km of Fez", or "landed right on Fez" for a dead-centre guess.
function feat(km, item) {
  return km < 1 ? `landed right on ${placeName(item)}` : `got within ${kmLabel(km)} of ${placeName(item)}`;
}

function challengeUrl(item, km, name) {
  const url = new URL(location.pathname, location.origin);
  url.searchParams.set('challenge', item.id);
  url.searchParams.set('dist', String(km));
  if (name) url.searchParams.set('name', name);
  return url.href;
}

function readChallengeLink() {
  const params = new URLSearchParams(location.search);
  if (!params.has('challenge')) return null;
  const id = params.get('challenge') || '';
  const rawDist = params.get('dist');
  const d = Number(rawDist);
  return {
    item: /^[\p{L}\p{N}_-]{1,64}$/u.test(id) ? passportLocation(id) || null : null,
    dist: rawDist !== null && rawDist.trim() !== '' && Number.isFinite(d) && d >= 0 && d <= MAX_KM ? Math.round(d) : null,
    name: cleanName(params.get('name')),
  };
}

const challengeKey = (link) => `${link.item.id}|${link.dist ?? ''}|${link.name.toLowerCase()}`;

function takenChallenges() {
  const all = readJSON(CHALLENGES_KEY);
  return all && typeof all === 'object' && !Array.isArray(all) ? all : {};
}

function finishChallenge(km) {
  const all = takenChallenges();
  all[challenge.key] = { km, t: Date.now() };
  const keys = Object.keys(all).sort((a, b) => (all[a].t || 0) - (all[b].t || 0));
  while (keys.length > CHALLENGES_LIMIT) delete all[keys.shift()];
  writeJSON(CHALLENGES_KEY, all);
  fillVersus(km);
}

// Head to head. Positive diff: the friend (you) landed closer.
function versus(km, link) {
  const who = link.name || 'Your friend';
  if (link.dist == null) return { result: 'none', who, line: 'Send it back and set the bar.' };
  const diff = link.dist - km;
  if (diff > 0) return { result: 'win', who, line: `🏆 You beat ${who} by ${kmLabel(diff)}!` };
  if (diff < 0) return { result: 'lose', who, line: `${who} wins this one, by ${kmLabel(-diff)}.` };
  return { result: 'tie', who, line: '🤝 Dead heat, to the kilometre.' };
}

function fillVersus(km) {
  const v = versus(km, challenge);
  const [me, them] = chVs.querySelectorAll('.ch-side');
  me.querySelector('b').textContent = kmLabel(km);
  them.querySelector('small').textContent = v.who;
  them.querySelector('b').textContent = challenge.dist == null ? '—' : kmLabel(challenge.dist);
  me.classList.toggle('win', v.result === 'win');
  them.classList.toggle('win', v.result === 'lose');
  chVerdict.textContent = v.line;
  chVerdict.dataset.result = v.result;
  chReply.textContent = challenge.name ? `↩ Reply to ${challenge.name}` : '↩ Send it back';
  chPlay.textContent = daily && daily.complete ? 'Today’s results →' : 'Today’s game →';
}

