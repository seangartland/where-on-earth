function revealGuess(guess, restoring = false) {
  if (gameMode !== 'guess' && !restoring) return;
  const answer = currentItem();
  const kmExact = distanceKm(guess, answer);
  const km = Math.round(kmExact);
  const oneOff = endless.active || challenge.active; // unscored, outside the daily
  const score = oneOff ? 0 : scoreGuess(kmExact, daily.round);
  if (!restoring && !oneOff) {
    daily.results[daily.round] = { guess, distance: km, score };
    saveDaily();
  }
  lastReveal = { item: answer, km };
  if (challenge.active && !restoring) finishChallenge(km);
  gameMode = 'reveal';
  window.__canGuess = false;
  document.body.className = endless.active ? 'game-reveal endless' : challenge.active ? 'game-reveal challenge' : 'game-reveal';
  gameEls.hint.textContent = '';
  gameEls.hint.style.display = 'none';
  gameEls.distance.textContent = window.__travelAnim && !restoring ? '0 km' : `${km.toLocaleString()} km`;
  const base = Math.round(100 * Math.exp(-kmExact / 4650));
  const newlyEarned = !restoring ? recordVisit(answer.id, base, kmExact) : 0; // exact, so earning matches the flyover tier
  const weight = WEIGHTS[daily.round];
  gameEls.baseScore.textContent = base;
  gameEls.mult.textContent = `×${weight}`;
  gameEls.mult.style.display = weight > 1 ? '' : 'none';
  gameEls.score.textContent = `+${score}`;
  gameEls.fact.textContent = answer.fact;
  setThumb(gameEls.thumb, answer.image);
  gameEls.next.textContent = endless.active ? 'Next location' : daily.round === 4 ? 'See results' : 'Next round';
  const tier = flyoverTier(kmExact);
  const animate = window.__travelAnim !== false && !restoring;
  // Queue the earn celebration for after the flyover completes.
  // For bullseye (no flyover) or no-animation, show immediately.
  if (newlyEarned) {
    if (animate && tier !== 'bullseye') {
      window.__pendingEarn = { answer, tier: newlyEarned };
    } else {
      // Bullseye or no animation: show after a brief delay so the reveal settles
      setTimeout(() => showEarnToast(answer, newlyEarned), animate ? 800 : 100);
    }
  }
  if (animate && tier === 'bullseye') {
    document.body.classList.add('bullseye');
    gameEls.hint.textContent = 'Bullseye! The gold marker shows the answer';
    beginBullseyeReveal(guess, answer, km);
  } else if (animate) beginTravelReveal(guess, answer, km);
  else {
    gameEls.reveal.hidden = false;
    placeRevealVisual(guess, answer);
  }
}

// Drop the old src when there's no image, so a previous round's photo can't linger.
function setThumb(img, url) {
  if (url) img.src = url;
  else img.removeAttribute('src');
  img.hidden = !url;
}

function scoreEmoji(base) {
  if (base >= 100) return '🎯';
  if (base >= 90) return '🔥';
  if (base >= 70) return '🏆';
  if (base >= 40) return '🙂';
  if (base >= 1) return '😅';
  return '🥶';
}

function shareText() {
  const dateStr = new Date(`${daily.date}T12:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  const total = daily.results.reduce((sum, result) => sum + result.score, 0);
  const lines = daily.results.map((result, index) => {
    const base = Math.round(result.score / WEIGHTS[index]);
    return `${base} ${scoreEmoji(base)}`;
  });
  return `Where on Earth?\n${dateStr}\n\nFinal Score: ${total}\n\n${lines.join('\n')}\n\nCan you beat me?\nhttps://where-on-earth-liard.vercel.app`;
}

function showResults() {
  clearReveal();
  hideScreens();
  gameMode = 'results';
  window.__canGuess = false;
  gameEls.results.hidden = false;
  document.body.classList.add('game-results');
  daily.complete = true;
  saveDaily();
  const streak = finishStreak();
  recordHistory();
  const total = daily.results.reduce((sum, result) => sum + result.score, 0);
  gameEls.total.textContent = total;
  gameEls.resultStreak.textContent = `🔥 ${streak} day streak`;
  gameEls.breakdown.replaceChildren(...daily.results.map((result, i) => {
    const li = document.createElement('li');
    li.innerHTML = `<b>${i + 1}</b><span class="place"></span><span class="points">${result.score}<small>${result.distance.toLocaleString()} km</small></span>`;
    li.querySelector('.place').textContent = selected[i].short || selected[i].clue;
    return li;
  }));
  tickCountdown();
}

function startGame() {
  endless.active = false;
  leaveChallenge();
  if (daily.date !== localDateKey()) loadDaily(); // page left open past midnight
  if (daily.complete && daily.results.length === 5) showResults();
  else if (daily.results[daily.round]) {
    showRound();
    revealGuess(daily.results[daily.round].guess, true);
  } else showRound();
}

function nextRound() {
  if (gameMode !== 'reveal') return;
  if (endless.active) endlessNext();
  else if (daily.round >= 4) showResults();
  else {
    daily.round += 1;
    saveDaily();
    showRound();
  }
}

async function shareResult() {
  const text = shareText();
  try {
    if (navigator.share) {
      await navigator.share({ text });
      return;
    }
  } catch (err) {
    if (err && err.name === 'AbortError') return;
  }
  try {
    await navigator.clipboard.writeText(text);
    gameEls.share.textContent = 'Copied';
    gameEls.status.textContent = 'Result copied to clipboard';
  } catch {
    gameEls.status.textContent = 'Could not copy this result';
  }
}

