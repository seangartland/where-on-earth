function challengeMessage(share) {
  const place = placeName(share.item);
  const vs = share.vs;
  if (vs && vs.km != null) {
    const diff = vs.km - share.km;
    if (diff > 0) return { note: `Beat your ${kmLabel(vs.km)} at ${place}: I ${share.km < 1 ? 'landed right on it' : `got within ${kmLabel(share.km)}`}. Your move.`, share: `📮 I beat your ${kmLabel(vs.km)} at ${place} on Where on Earth: ${kmLabel(share.km)}. Your move.` };
    if (diff < 0) return { note: `You got me at ${place}: my ${kmLabel(share.km)} to your ${kmLabel(vs.km)}. Well played.`, share: `📮 You got me at ${place} on Where on Earth: my ${kmLabel(share.km)} to your ${kmLabel(vs.km)}. Well played.` };
    return { note: `Dead heat at ${place}: we both got within ${kmLabel(share.km)}!`, share: `📮 Dead heat at ${place} on Where on Earth: we both got within ${kmLabel(share.km)}!` };
  }
  return {
    note: `I ${feat(share.km, share.item)}. Can you beat it?`,
    share: `📮 I ${feat(share.km, share.item)} on Where on Earth. Can you beat it?`,
  };
}

